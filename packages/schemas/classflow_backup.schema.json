{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classflow.org/schemas/classflow_backup.schema.json",
  "title": "ClassFlowBackupPackage",
  "type": "object",
  "required": [
    "manifest",
    "semesters",
    "courses",
    "exceptions"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "formatVersion",
        "appVersion",
        "exportedAt",
        "checksum"
      ],
      "properties": {
        "formatVersion": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "appVersion": {
          "type": "string"
        },
        "exportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "checksum": {
          "type": "string"
        },
        "semestersCount": {
          "type": "integer",
          "minimum": 0
        },
        "coursesCount": {
          "type": "integer",
          "minimum": 0
        },
        "exceptionsCount": {
          "type": "integer",
          "minimum": 0
        },
        "calendarEventsCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "semesters": {
      "type": "array",
      "items": {
        "$ref": "semester.schema.json"
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "course.schema.json"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "schedule_exception.schema.json"
      }
    },
    "settings": {
      "type": "object"
    },
    "calendarEvents": {
      "type": "array",
      "items": {
        "$ref": "calendar_event.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest": {
            "properties": {
              "formatVersion": {
                "const": 2
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "calendarEvents"
        ],
        "properties": {
          "manifest": {
            "required": [
              "calendarEventsCount"
            ]
          }
        }
      }
    }
  ]
}
