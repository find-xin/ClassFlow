{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classflow.org/schemas/course.schema.json",
  "title": "Course",
  "type": "object",
  "required": [
    "id",
    "semesterId",
    "name",
    "color",
    "schedules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "semesterId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "teacher": {
      "type": ["string", "null"],
      "maxLength": 60
    },
    "color": {
      "type": "string",
      "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$"
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "dayOfWeek",
          "startSection",
          "endSection",
          "weekPattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "startSection": {
            "type": "integer",
            "minimum": 1
          },
          "endSection": {
            "type": "integer",
            "minimum": 1
          },
          "classroom": {
            "type": ["string", "null"],
            "maxLength": 60
          },
          "weekPattern": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["all", "odd", "even", "custom"]
              },
              "customWeeks": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
