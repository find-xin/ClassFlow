{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classflow.org/schemas/semester.schema.json",
  "title": "Semester",
  "type": "object",
  "required": [
    "id",
    "name",
    "startDate",
    "endDate",
    "totalWeeks",
    "isCurrent",
    "timeZone",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "totalWeeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "isCurrent": {
      "type": "boolean"
    },
    "timeZone": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section", "startTime", "endTime"],
        "properties": {
          "section": {
            "type": "integer",
            "minimum": 1
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
